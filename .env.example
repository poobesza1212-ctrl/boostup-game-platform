PORT=5000
NODE_ENV=production
APP_NAME=TWELVE SYSTEMS
APP_URL=https://your-domain.com

# Security Secret
SESSION_SECRET=your_production_secret_key_here

# Default Contact & Support
LINE_CONTACT=@your_line_oa
SUPPORT_PHONE=02-xxx-xxxx

# Payment Gateway Configuration
PROMPTPAY_NUMBER=089xxxxxxx
PROMPTPAY_NAME=Your Company Name
DEFAULT_BANK_NAME=ธนาคารกสิกรไทย (KBANK)
DEFAULT_BANK_ACCOUNT=xxx-x-xxxxx-x
DEFAULT_BANK_ACCOUNT_NAME=Your Company Name

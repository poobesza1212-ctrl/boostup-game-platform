{
  "appId": "com.boostup.gametopup",
  "appName": "BOOSTUP เติมเกม",
  "webDir": "client/dist",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "packageManager": "SPM"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0b0f19",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0b0f19"
    }
  }
}
